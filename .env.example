# Copie este archivo como .env y cambie los valores.
# El superadministrador solo se crea la primera vez (cuando la base está vacía).
SPIN_ADMIN_EMAIL=admin@spin.local
SPIN_ADMIN_CLAVE=CambieEsta2026
SPIN_ADMIN_NOMBRE=Administrador SPIn
SPIN_PUERTO=8080

# Datos de demostración (Entrega 10): true = la primera vez que arranca con la base vacía, carga 30 meses de
# historia, 90 días de operación y entrena el pronóstico (1 a 3 minutos). No toca una base que ya tiene datos.
SPIN_DEMO=true
